OPENAI_API_KEY=

# ─── Database (Neon Postgres in production, SQLite locally) ───────────────────
# LOCAL DEV: leave as-is — SQLite runs automatically, no setup needed.
# PRODUCTION (Vercel):
#   DATABASE_DRIVER=postgres
#   DATABASE_URL=postgresql://...-pooler....neon.tech/neondb?sslmode=require   ← pooled (app)
#   DATABASE_URL_UNPOOLED=postgresql://....neon.tech/neondb?sslmode=require     ← direct (migrations)
#
# Run migrations (use unpooled URL — poolers reject DDL):
#   DATABASE_DRIVER=postgres DATABASE_URL=<UNPOOLED_URL> npm run db:migrate
#
# ── RLS app_user role (required for production tenant isolation) ────────────────────────────
# After running scripts/provision-app-role.sql in the Neon console, set
# APP_DATABASE_URL to the app_user connection string (pooled). The app will
# prefer it over DATABASE_URL, and RLS tenant_isolation policies will enforce
# per-tenant scoping without the owner bypass. DATABASE_URL (owner) is still
# used for migrations and admin cross-tenant queries.
# APP_DATABASE_URL=postgresql://app_user:...@...-pooler....neon.tech/neondb?sslmode=require
DATABASE_URL=file:./data/leads.db
# DATABASE_DRIVER=postgres
# DATABASE_URL_UNPOOLED=

# ─── Admin / session secrets ──────────────────────────────────────────────────
# PRODUCTION: every secret below MUST be a unique 32+ char random string.
# Generate with: openssl rand -base64 32
# Local development has demo defaults; production rejects missing or weak
# administrative credentials. Generate independent strong values before deployment.
ADMIN_PASSWORD=
# Signing secret for the global agency-admin session cookie.
ADMIN_SESSION_SECRET=
# Signing secret for per-gym (owner) dashboard session cookies.
GYM_ADMIN_SESSION_SECRET=
# Bearer token required by cron routes (/api/cron/*). 32+ char random.
CRON_SECRET=
# Password-protect the whole site + /api/chat (leave empty to disable gate).
# PRODUCTION: MUST be empty — a non-empty value breaks customer embeds.
SITE_PASSWORD=
# Optional separate signing secret for site-gate cookies (defaults to SITE_PASSWORD)
# SITE_GATE_SECRET=
APP_URL=http://localhost:3000

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Required in production: serverless instances don't share memory, so without
# Upstash the per-IP / per-gym rate limits reset on every cold start. Neon does
# NOT replace this. Create a free Upstash Redis DB and paste its REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Embed access control ─────────────────────────────────────────────────────
# Per-gym signed embed token. When EMBED_TOKEN_SECRET is set, the admin
# dashboard emits a data-token on the snippet. Tokens are only ENFORCED on
# /api/chat + /api/gym/:id/config when EMBED_ENFORCE_TOKEN=true, so you can roll
# the secret out before flipping enforcement on. 32+ char random.
EMBED_TOKEN_SECRET=
EMBED_ENFORCE_TOKEN=false

# ─── CRM integration webhooks ─────────────────────────────────────────────────
# HMAC-SHA256 shared secret verifying inbound /api/webhooks/integrations/* POSTs.
# Per-gym override: INTEGRATIONS_WEBHOOK_SECRET_<GYM_ID> (gymId upper snake-cased,
# e.g. INTEGRATIONS_WEBHOOK_SECRET_ACME_HVAC). In production an unset secret
# fails closed (503). Set ALLOW_UNSIGNED=true only for local testing.
INTEGRATIONS_WEBHOOK_SECRET=
# INTEGRATIONS_WEBHOOK_ALLOW_UNSIGNED=true

# ─── Email notifications (Resend) ─────────────────────────────────────────────
# Set RESEND_API_KEY to enable owner email alerts on new leads and weekly digest.
RESEND_API_KEY=
# From address used in all outgoing emails (default: Redt Dunn <hello@dunnconsulting.org>)
RESEND_FROM=
# Fallback owner email used when a gym's config has no ownerEmail/contactEmail.
OWNER_EMAIL=

# ─── Phone / voice (Twilio) ───────────────────────────────────────────────────
# These are only needed for the voice call-routing / missed-call webhook.
# SMS sending has been replaced by Resend email — TWILIO vars below are NOT
# required for lead notifications or digest emails.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that receives inbound calls (used in gym config.twilio.fromNumber).
TWILIO_PHONE_NUMBER=
# Owner / staff phone for call forwarding (config.twilio.forwardTo / ownerPhone).
OWNER_PHONE=
# Set true only for local webhook testing without signature validation
SKIP_TWILIO_SIGNATURE=false
# Set to true to re-enable demo-gym on production (local staging only — never for live customers).
# ALLOW_DEMO_GYM=true
# Set to true to allow opening /widget?gym=... directly in a browser tab in production
# (for QA only — leave unset/false so the widget is embed-only).
# ALLOW_WIDGET_PREVIEW=true

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Lead-gen engine: Google Cloud key with "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# Set to false to silence chat debug logs in development
CHAT_DEBUG=false

# Set to true to show admin link on landing page during development
SHOW_ADMIN_LINK=true

# Set to true to greet returning visitors with "Welcome back, <name>!" after
# lead capture (stored in browser localStorage).
# NEXT_PUBLIC_RETURNING_LEAD_GREETING=false
